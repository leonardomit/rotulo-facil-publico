DEBUG=True
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave blank to use SQLite (dev default)
DATABASE_URL=

# PostgreSQL (for production / docker-compose)
# DATABASE_URL=postgres://rotulo:rotulo@db:5432/rotulo_facil

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Atalho para o Regula (controle regulatório) no cabeçalho.
# Vazio ou ausente = o botão não aparece.
REGULA_URL=

# Vercel — configure no painel do projeto (Settings → Environment Variables):
# DEBUG=False
# SECRET_KEY=<string longa aleatória — gere com: python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=.vercel.app
# CSRF_TRUSTED_ORIGINS=https://<projeto>.vercel.app
# DATABASE_URL=<Postgres externo: Neon/Supabase/Vercel Postgres>
# OPS_TOKEN=<token dos endpoints /healthz/ — gere com: python -c "import secrets; print(secrets.token_urlsafe(32))">
# REGULA_URL=https://<projeto-regula>.vercel.app  (opcional — botão no cabeçalho)
# Migrações: rode localmente com DATABASE_URL apontando ao banco remoto:
#   DATABASE_URL=... python3 manage.py migrate
